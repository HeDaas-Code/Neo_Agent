/* ===== Neo Agent TUI 主题：琥珀温暖 ===== */

/* === 全局样式 === */
Screen {
    background: #050302;
    color: #F5E6D3;
}

/* === 状态栏 === */
#status-bar {
    height: 1;
    background: #12100D;
    padding: 0 2;
    color: #F5E6D3;
}

/* === 主容器 === */
#main-container {
    height: 1fr;
}

/* === 侧边栏 === */
#sidebar {
    width: 25%;
    background: #0A0805;
    padding: 1 2;
}

.sidebar-title {
    padding: 0 0 1 0;
    color: #E9A568;
}

.sidebar-section {
    padding: 2 0 1 0;
    color: #8A6B4F;
}

/* === 导航项（Button 样式） === */
.nav-item {
    height: 3;
    width: 1fr;
    min-width: 100%;
    padding: 0 2;
    background: transparent;
    color: #C9B89A;
    content-align: left middle;
    border: none;
    text-align: left;
}

.nav-item:hover {
    background: #12100D;
    color: #E9A568;
    text-style: bold;
}

.nav-item.selected {
    background: #1C1812;
    color: #E9A568;
    text-style: bold;
    border-left: thick #E9A568;
}

.nav-item:focus {
    background: #12100D;
}

.nav-hint {
    padding: 0 2;
    color: #8A7A66;
}

.nav-hint:hover {
    color: #D4863C;
}

/* === 内容区域 === */
#content-area {
    background: #050302;
    width: 75%;
    padding: 2;
}

.view-title {
    padding: 0 0 1 0;
    text-style: bold;
    color: #E9A568;
}

.section-title {
    padding: 1 0 0 0;
    color: #C9B89A;
    text-style: bold;
}

/* === 对话视图 === */
#chat-history {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
    padding: 1;
    margin-bottom: 1;
}

#chat-input-area {
    height: 3;
}

#chat-input {
    background: #0A0805;
    border: solid #1C1812;
    color: #F5E6D3;
}

#chat-input:focus {
    border: solid #E9A568;
}

#send-button {
    background: #1C1812;
    color: #E9A568;
    margin-left: 1;
}

#send-button:hover {
    background: #E9A568;
    color: #050302;
    text-style: bold;
}

/* === 行程视图 === */
#itinerary-table {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
}

DataTable {
    background: #0A0805;
    color: #F5E6D3;
}

DataTable > .datatable--header {
    background: #12100D;
    color: #E9A568;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1C1812;
    color: #E9A568;
}

/* === 场景池视图 === */
#scene-list {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
}

.scene-item {
    padding: 1;
    background: #0A0805;
    margin-bottom: 1;
    border: solid #1C1812;
}

.scene-item:hover {
    background: #12100D;
    border: solid #E9A568;
}

.scene-name {
    color: #E9A568;
    text-style: bold;
}

.scene-description {
    color: #C9B89A;
    padding: 0 0 0 2;
}

.scene-meta {
    color: #8A6B4F;
    padding: 0 0 0 2;
}

/* === 记忆视图 === */
#memory-search {
    height: 3;
    background: #0A0805;
    border: solid #1C1812;
    margin-bottom: 1;
}

#memory-search:focus {
    border: solid #E9A568;
}

#memory-results {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
}

.memory-item {
    padding: 1;
    margin-bottom: 1;
    background: #0A0805;
    border-left: thick #D4863C;
}

.memory-content {
    color: #F5E6D3;
}

.memory-meta {
    color: #8A6B4F;
    padding-top: 1;
}

/* === 关系视图 === */
#relationship-list {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
}

.relationship-item {
    padding: 1;
    margin-bottom: 1;
    background: #0A0805;
    border: solid #1C1812;
}

.relationship-item:hover {
    background: #12100D;
    border: solid #D4863C;
}

.relationship-entity {
    color: #E9A568;
    text-style: bold;
}

.relationship-score {
    color: #A8C079;
}

.relationship-score.negative {
    color: #D97757;
}

.relationship-history {
    color: #8A6B4F;
    padding: 0 0 0 2;
}

/* === 审计日志视图 === */
#audit-log {
    height: 1fr;
    background: #0A0805;
    border: solid #1C1812;
}

.audit-entry {
    padding: 1;
    margin-bottom: 1;
    background: #0A0805;
}

.audit-timestamp {
    color: #8A6B4F;
}

.audit-action {
    color: #E9A568;
    text-style: bold;
}

.audit-details {
    color: #C9B89A;
    padding: 0 0 0 2;
}

.audit-risk-high {
    border-left: thick #D97757;
}

.audit-risk-medium {
    border-left: thick #E9A568;
}

.audit-risk-low {
    border-left: thick #A8C079;
}

/* === 底部状态栏 === */
Footer {
    background: #12100D;
}

Footer > .footer--highlight {
    background: #E9A568;
    color: #050302;
}

Footer > .footer--highlight-key {
    background: #1C1812;
    color: #E9A568;
}

Footer > .footer--key {
    background: #0A0805;
    color: #8A6B4F;
}

/* === 加载状态 === */
.loading {
    color: #D4863C;
    text-style: italic;
}

.error {
    color: #D97757;
    text-style: bold;
}

.success {
    color: #A8C079;
}

/* === 通用组件 === */
Button {
    background: #1C1812;
    color: #E9A568;
    border: solid #2B231C;
}

Button:hover {
    background: #E9A568;
    color: #050302;
    text-style: bold;
}

Button:focus {
    border: solid #E9A568;
}

Input {
    background: #0A0805;
    border: solid #1C1812;
    color: #F5E6D3;
}

Input:focus {
    border: solid #E9A568;
}

RichLog {
    background: #0A0805;
    color: #F5E6D3;
}

Static {
    background: transparent;
}
