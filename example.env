# =====================================================================
# Neo Agent v3.1.0 — Example Environment Variables
# =====================================================================

# ---------------------------------------------------------------------
# 一、LLM 通用配置（v3.1.0+ 推荐使用）
# ---------------------------------------------------------------------
# 供应商预设：openai / deepseek / siliconflow / moonshot / zhipu / custom
LLM_PROVIDER=siliconflow
# API Key（推荐用 LLM_API_KEY，兼容旧 SILICONFLOW_API_KEY）
LLM_API_KEY=
# 自定义 base_url（preset 模式可省略，custom 模式必填）
# LLM_BASE_URL=https://api.openai.com/v1
# 自定义模型名（preset 模式可省略）
# LLM_MODEL_NAME=gpt-4o-mini
# 全局超时/温度/最大 tokens
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
# 三层模型独立名称（MAIN/TOOL/VISION）
# MAIN_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
# TOOL_MODEL_NAME=zai-org/GLM-4.6V
# VISION_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct

# ---------------------------------------------------------------------
# 一·A、兼容旧版（v3.0.x 风格，推荐迁移到上方 LLM 通用配置）
# ---------------------------------------------------------------------
# （兼容旧版，推荐迁移到上方 LLM 通用配置）
# API配置
SILICONFLOW_API_KEY=your-api-key
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions

# SerpAPI配置（用于网络搜索工具）
SERPAPI_API_KEY=your-serpapi-key

# ---------------------------------------------------------------------
# 二、多层模型架构
# ---------------------------------------------------------------------
# 主模型：处理主要对话和复杂推理任务
MAIN_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
MAIN_MODEL_TEMPERATURE=0.8
MAIN_MODEL_MAX_TOKENS=2000
# MAIN_MODEL_TIMEOUT=60  # API请求超时时间（秒），默认60秒

# 小模型：处理工具调用、意图识别等轻量级任务
TOOL_MODEL_NAME=zai-org/GLM-4.6V
TOOL_MODEL_TEMPERATURE=0.3
TOOL_MODEL_MAX_TOKENS=500
# TOOL_MODEL_TIMEOUT=45  # API请求超时时间（秒），默认45秒

# 多模态模型：处理视觉识别和多模态推理
VISION_MODEL_NAME=Qwen/Qwen3-VL-32B-Instruct
VISION_MODEL_TEMPERATURE=0.5
VISION_MODEL_MAX_TOKENS=1000
# VISION_MODEL_TIMEOUT=90  # API请求超时时间（秒），默认90秒

# 兼容旧配置（如果未设置上述新配置，将使用此默认值）
MODEL_NAME=deepseek-ai/DeepSeek-V3
TEMPERATURE=0.8
MAX_TOKENS=2000

# 视觉工具LLM判断配置（可选）
# VISION_LLM_TEMPERATURE=0.3
# VISION_LLM_MAX_TOKENS=10
# VISION_LLM_TIMEOUT=10

# 提示词配置（使用markdown模板系统）
# 角色提示词文件名（不含.md后缀），默认使用default_character
# CHARACTER_PROMPT_FILE=default_character
# 世界观文件名（不含.md后缀），默认使用default_world
# WORLDVIEW_FILE=default_world

# 多智能体协作配置
# 是否启用基于LangGraph的动态协作图（默认True）
# USE_DYNAMIC_MULTI_AGENT=True

# 默认设置
# 角色设定
CHARACTER_NAME=小可
CHARACTER_GENDER=女
CHARACTER_ROLE=学生
CHARACTER_HEIGHT=150cm
CHARACTER_WEIGHT=45kg
CHARACTER_PERSONALITY=活泼开朗
CHARACTER_HOBBY=文科，尤其对历史充满热情
CHARACTER_AGE=18

# 详细人设描述
CHARACTER_BACKGROUND=我是一名高中生，叫小可。我身高150cm，体重45kg。我性格活泼开朗，特别喜欢文科，尤其对历史充满热情。我喜欢阅读历史书籍，常常能从历史故事中获得启发。我说话比较俏皮可爱，喜欢和朋友们分享有趣的历史知识。

# 记忆设置
MEMORY_FILE=memory_data.json
LONG_MEMORY_FILE=longmemory_data.json
MAX_MEMORY_MESSAGES=50
MAX_SHORT_TERM_ROUNDS=20

# Debug模式
DEBUG_MODE=True
DEBUG_LOG_FILE=debug.log

# NPS工具系统LLM配置（可选）
# NPS_LLM_TEMPERATURE=0.3
# NPS_LLM_MAX_TOKENS=100
# NPS_LLM_TIMEOUT=10

# DeepAgents增强配置
# 是否使用DeepAgents增强的子智能体（默认True）
# USE_DEEP_AGENTS=True
# 是否启用持久化状态管理（默认True）
# ENABLE_PERSISTENT_STATE=True
# 注：USE_DEEPAGENTS_KNOWLEDGE 已弃用（v2.2.0 删除 DeepAgentsKnowledgeManager）
